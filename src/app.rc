// The icon and version info (out\version.h is written by build.cmd from VERSION).
#include <winver.h>
#include "version.h"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION EXO_VERSION_COMMA
PRODUCTVERSION EXO_VERSION_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Erix (UhhErix)"
      VALUE "FileDescription", "Exo Browser"
      VALUE "FileVersion", EXO_VERSION_TEXT
      VALUE "InternalName", "ExoBrowser"
      VALUE "LegalCopyright", "Copyright (c) 2026 Erix (UhhErix)"
      VALUE "OriginalFilename", "ExoBrowser.exe"
      VALUE "ProductName", "Exo Browser"
      VALUE "ProductVersion", EXO_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
